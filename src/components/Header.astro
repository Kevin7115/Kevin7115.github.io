---
import { Image } from 'astro:assets';
// import sg from '../assets/Satoru_Gojo.jpg';
// import sg from '../assets/oooo.jpeg';
import sg from '../assets/profile3.jpg';
---

<section id="header" class="hero">
  <div class="hero-grid">
    <div class="hero-text">
      <span class="eyebrow">Hey! I'm</span>
      <h1>Kevin Santiago</h1>
      <p class="role">Software Engineer <span class="sep">&bull;</span> MIT '27</p>

      <div class="social-icons">
        <a class="icon-box" href="https://www.linkedin.com/in/kevin-santiago7/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.33V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"/></svg>
        </a>
        <a class="icon-box" href="https://github.com/Kevin7115" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.15c-3.2.7-3.88-1.4-3.88-1.4-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.64 1.6.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.44-2.7 5.42-5.28 5.7.42.36.78 1.08.78 2.18v3.24c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
        </a>
        <a class="icon-box" href="mailto:kevin711san@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="M3 6.5 12 13l9-6.5"/></svg>
        </a>
      </div>
    </div>

    <div class="hero-image-wrap">
      <div class="hero-image">
        <Image src={sg} alt="Kevin Santiago" width={480} height={600} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(100vh - 6rem);
    /* background: black; */
  }

  .hero-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    width: 100%;
    flex-wrap: wrap;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 380px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    /* text-transform: uppercase; */
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--gold);
  }

  .role {
    margin: 1rem 0 2rem;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 500;
  }

  .sep {
    color: var(--gold);
    margin: 0 0.3rem;
  }

  .social-icons {
    display: flex;
    gap: 0.85rem;
  }

  .icon-box {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-secondary);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .icon-box svg {
    width: 20px;
    height: 20px;
  }

  .icon-box:hover {
    color: var(--gold);
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .hero-image-wrap {
    flex: 1 1 320px;
    display: flex;
    justify-content: center;
  }

  .hero-image {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    border-radius: 190px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero-grid {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-text {
      align-items: center;
    }
  }
</style>
