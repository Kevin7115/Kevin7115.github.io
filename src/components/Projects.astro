---
import { Image } from "astro:assets";
import { techIcon } from "../utils/icons.js";
import chatbot_img from "../assets/chatbot2.png"
import flappyAI_img from "../assets/flappyAI-img2.png"
import wordhunt_img from "../assets/wordhunt-img2.png"

const projects = [
    {
        "title": "Character Chatbots",
        "date": "Dec 2025",
        "description": "Developed a multi-agent chatbot platform that supports concurrent, real-time conversations with customizable AI characters. Built a FastAPI backend to handle asynchronous message routing between the OpenAI and ElevenLabs APIs. Integrated Azure Speech-to-Text to enable real-time voice interactions between users and chatbots.",
        "image": chatbot_img,
        "github": "https://github.com/Kevin7115/Multi-Character-Chatbots",
        "live_view": "",
        "showLive": true,
        "skills": ["Python", "React", "FastAPI"]
    },
    {
        "title": "Flappy Bird AI",
        "date": "Oct 2024",
        "description": "Built a custom Gymnasium environment to train and evaluate reinforcement learning agents playing Flappy Bird. Implemented a Deep Q-Network (DQN) in PyTorch and used Matplotlib to visualize training in real time and analyze agent performance across iterations.",
        "image": flappyAI_img,
        "github": "https://github.com/Kevin7115/Flappy-Bird-AI",
        "live_view": "",
        "showLive": true,
        "skills": ["Python", "Pytorch", "Numpy"]
    },
    {
        "title": "WordHunt Solver",
        "date": "Feb 2026",
        "description": "Developed a solver for GamePigeon’s WordHunt using trie-based depth-first search to efficiently find valid words on a game board. Built a React web interface for entering board letters and displaying results, backed by a Spring Boot API that processes the board and returns matching words.",
        "image": wordhunt_img,
        "github": "https://github.com/Kevin7115/WordHunt-Solver",
        "live_view": "",
        "showLive": false,
        "skills": ["Java", "React", "Spring Boot"]
    }
];
---

<section id="projects" class="projects">
  <h2>Projects</h2>

  <div class="projects-grid">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-media">
          {project.image ? (
            <Image src={project.image} alt={project.title} width={800} height={500} />
          ) : (
            <div class="media-placeholder">
              <span>Image / Demo</span>
            </div>
          )}
        </div>

        <div class="project-body">
          <h3>{project.title}</h3>
          {/* <p class="project-date">{project.date}</p> */}
          <p class="project-desc">{project.description}</p>

          <div class="project-links">
            <a class="icon-box" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} repository`}>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.15c-3.2.7-3.88-1.4-3.88-1.4-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.64 1.6.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.44-2.7 5.42-5.28 5.7.42.36.78 1.08.78 2.18v3.24c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
            </a>

            {project.showLive && project.live_view && (
              <a class="icon-box" href={project.live_view} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} live`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M10 14 20 4"/><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/></svg>
              </a>
            )}
          </div>

          <div class="project-skills">
            {project.skills.map((skill) => {
              const icon = techIcon(skill);
              return (
                <span class="skill-icon" title={skill}>
                  <img
                    src={icon.url}
                    alt={skill}
                    loading="lazy"
                    class:list={{ invert: icon.invert }}
                  />
                </span>
              );
            })}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    margin: 0 0 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
  }

  .project-media {
    aspect-ratio: 16 / 10;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-placeholder span {
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }

  .project-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: left;
    flex: 1;
  }

  .project-body h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .project-date {
    margin: 0;
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .project-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .icon-box {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .icon-box svg {
    width: 18px;
    height: 18px;
  }

  .icon-box:hover {
    color: var(--gold);
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .project-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .skill-icon {
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
  }

  .skill-icon img {
    width: 18px;
    height: 18px;
  }

  .skill-icon img.invert {
    filter: invert(1);
  }

  @media (max-width: 960px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
